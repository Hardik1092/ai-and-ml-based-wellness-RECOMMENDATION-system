  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PredictRequest": {
        "properties": {
          "features": {
            "additionalProperties": true,
            "type": "object",
            "title": "Features"
          },
          "raw": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Raw"
          }
        },
        "type": "object",
        "title": "PredictRequest"
      },
      "RetrainRequest": {
        "properties": {
          "extra_rows": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Extra Rows"
          },
          "extra_labels": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Extra Labels"
          },
          "samples": {
            "type": "integer",
            "maximum": 100000.0,
            "minimum": 100.0,
            "title": "Samples",
            "default": 3000
          },
          "force": {
            "type": "boolean",
            "title": "Force",
            "default": false
          }
        },
        "type": "object",
        "title": "RetrainRequest"
      },
      "TrainRequest": {
        "properties": {
          "samples": {
            "type": "integer",
            "maximum": 100000.0,
            "minimum": 100.0,
            "title": "Samples",
            "default": 3000
          }
        },
        "type": "object",
        "title": "TrainRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
